     esp_err_t err = esp_pm_configure(&cfg);
-    ESP_LOGD(TAG, "cpu %dMHz (no auto_ls): %s", mhz, esp_err_to_name(err));
+    ESP_LOGI(TAG, "cpu max=%d min=%d auto_ls=%d: %s", mhz, cfg.min_freq_mhz, auto_sleep, esp_err_to_name(err));
     return err;
     #else
     (void)mhz;
+    (void)auto_sleep;
